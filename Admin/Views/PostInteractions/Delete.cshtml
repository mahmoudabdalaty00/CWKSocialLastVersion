@model PostInteractionListItemViewModel
@{ ViewData["Title"] = "Delete interaction"; }

<div class="admin-confirm">
    <h1>Delete this interaction?</h1>
    <p>@Model.ReactionType on post #@Model.PostId.</p>

    <form asp-action="Delete" asp-route-id="@Model.Id">
        @Html.AntiForgeryToken()
        <div class="d-flex gap-2">
            <button class="btn btn-danger" type="submit">Delete interaction</button>
            <a class="btn btn-outline-secondary"
               asp-action="Details"
               asp-route-id="@Model.Id">Cancel</a>
        </div>
    </form>
</div>
