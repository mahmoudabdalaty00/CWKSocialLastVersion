@model PostInteractionListItemViewModel
@{ ViewData["Title"] = "Interaction #" + Model.Id; }

<div class="admin-page-header">
    <div>
        <h1>Interaction #@Model.Id</h1>
        <p>@Model.ReactionType</p>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Id">Edit</a>
        <a class="btn btn-outline-danger" asp-action="Delete" asp-route-id="@Model.Id">Delete</a>
    </div>
</div>

<dl class="admin-details">
    <dt>Post</dt>
    <dd>@Model.PostId</dd>
    <dt>Created</dt>
    <dd>@Model.CreatedAt.ToLocalTime().ToString("g")</dd>
</dl>

<a class="btn btn-outline-secondary"
   asp-controller="PostInteractions"
   asp-action="Index"
   asp-route-postId="@Model.PostId">Back to interactions</a>
