@model PostDetailsViewModel
@{ ViewData["Title"] = "Post #" + Model.Id; }

<div class="admin-page-header">
    <div>
        <h1>Post #@Model.Id</h1>
        <p>Published @Model.CreatedAt.ToLocalTime().ToString("g")</p>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Id">Edit</a>
        <a class="btn btn-outline-danger" asp-action="Delete" asp-route-id="@Model.Id">Delete</a>
    </div>
</div>

<article class="admin-card">
    <p class="mb-3 text-break">@Model.Content</p>
    <dl class="admin-details">
        <dt>Author</dt>
        <dd><code>@Model.UserProfileId</code></dd>
        <dt>Updated</dt>
        <dd>@Model.UpdatedAt?.ToLocalTime().ToString("g")</dd>
    </dl>
</article>

<div class="mt-3 d-flex gap-2">
    <a class="btn btn-outline-secondary"
       asp-controller="PostComments"
       asp-action="Index"
       asp-route-postId="@Model.Id">Comments</a>
    <a class="btn btn-outline-secondary"
       asp-controller="PostInteractions"
       asp-action="Index"
       asp-route-postId="@Model.Id">Interactions</a>
</div>
