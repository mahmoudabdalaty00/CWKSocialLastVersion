@model UserProfileDetailsViewModel
@{ ViewData["Title"] = "Delete profile"; }

<div class="admin-confirm">
    <h1>Delete @Model.FullName?</h1>
    <p>This will deactivate the profile. It can be restored from an administrative workflow.</p>

    <form asp-action="Delete" asp-route-id="@Model.Id">
        @Html.AntiForgeryToken()
        <div class="d-flex gap-2">
            <button class="btn btn-danger" type="submit">Delete profile</button>
            <a class="btn btn-outline-secondary"
               asp-action="Details"
               asp-route-id="@Model.Id">Cancel</a>
        </div>
    </form>
</div>
